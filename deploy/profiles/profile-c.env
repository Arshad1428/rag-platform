# Profile C - on-prem / air-gap: everything on your own GPU server, no internet needed after setup.
PROFILE=C
AUTH_MODE=demo                      # demo users for the prototype; real sites: AUTH_MODE=oidc (Keycloak, ADFS...)

OLLAMA_URL=http://localhost:11434   # in docker compose: http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3-vl:8b       # bigger GPU (24 GB+): qwen3-vl:30b for better answers
OLLAMA_SMALL_MODEL=qwen3-vl:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_EMBED_MODEL=bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

QDRANT_URL=                         # empty = built into the API; docker compose: http://qdrant:6333
OCR_MODE=auto                       # auto | on | off
DESCRIBE_IMAGES=true
VISION_CONCURRENCY=2
MIN_RELEVANCE=0.30                  # tune with: python -m eval.run_eval

# Fully offline after the first setup (models already downloaded):
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
