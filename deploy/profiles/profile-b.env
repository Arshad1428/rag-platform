# Profile B - restricted network: the same Azure services as profile A, reached only through
# Private Endpoints (no public internet). Code and settings are identical to A; the difference is
# in the Azure network setup: private endpoints + private DNS, public network access disabled,
# and the app running inside the same virtual network.
PROFILE=B
AUTH_MODE=entra_easyauth
SINGLE_TENANT=company-a

AOAI_ENDPOINT=https://<your-openai>.openai.azure.com/        # resolves to a private IP via private DNS
AOAI_CHAT_DEPLOYMENT=gpt-5.1
AOAI_SMALL_DEPLOYMENT=gpt-5-mini
AOAI_VISION_DEPLOYMENT=gpt-5.1
AOAI_EMBED_DEPLOYMENT=text-embedding-3-large
EMBED_DIMENSIONS=1024
DOCINTEL_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com/
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
BLOB_ACCOUNT_URL=https://<your-storage>.blob.core.windows.net
BLOB_CONTAINER=rag-data
MIN_RELEVANCE=0.50
