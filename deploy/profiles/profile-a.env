# Profile A - connected cloud (Azure). Sign-in via Azure Container Apps / App Service (Entra ID).
PROFILE=A
AUTH_MODE=entra_easyauth
SINGLE_TENANT=company-a             # one organisation; use AUTH_MODE=oidc with a tenant claim for several

AOAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AOAI_CHAT_DEPLOYMENT=gpt-5.1        # confirm the models offered in your region
AOAI_SMALL_DEPLOYMENT=gpt-5-mini
AOAI_VISION_DEPLOYMENT=gpt-5.1
AOAI_EMBED_DEPLOYMENT=text-embedding-3-large
EMBED_DIMENSIONS=1024
DOCINTEL_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com/
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
BLOB_ACCOUNT_URL=https://<your-storage>.blob.core.windows.net
BLOB_CONTAINER=rag-data
MIN_RELEVANCE=0.50                  # Azure semantic ranker 0-4 is rescaled to 0-1 (0.5 = 2.0)

# Cheaper option: keep the search index in Qdrant instead of Azure AI Search
# INDEX=qdrant
# QDRANT_URL=http://<your-qdrant-vm>:6333
# QDRANT_API_KEY=<from Key Vault>
